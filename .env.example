# Run npm run db:local to generate isolated local credentials in .env.local.
DATABASE_URL=postgresql://sampleify_app:CHANGE_ME@127.0.0.1:55442/sampleify_local
MIGRATION_DATABASE_URL=postgresql://sampleify_owner:CHANGE_ME@127.0.0.1:55442/sampleify_local
APP_ORIGIN=http://127.0.0.1:3000
# Exactly 32 random bytes encoded as hexadecimal; never expose in client code.
MFA_ENCRYPTION_KEY=CHANGE_ME
MAIL_TRANSPORT=local
