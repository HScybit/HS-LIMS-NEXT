{
  "name": "sampleify-lims",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.0 <23"
  },
  "scripts": {
    "dev": "npm run build:report-renderer && next dev --hostname 127.0.0.1",
    "build": "npm run build:report-renderer && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "db:local": "node scripts/local-database.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local scripts/migrate.js",
    "db:seed": "node --env-file=.env.local scripts/seed.js",
    "db:seed:demo": "node --env-file=.env.local scripts/seed-demo.js",
    "db:grant-platform-admin": "node --env-file=.env.local scripts/grant-platform-admin.js",
    "test": "node --test tests/unit/*.test.js",
    "test:integration": "npm run build:report-renderer && node --env-file=.env.local --test --test-concurrency=1 tests/integration/*.test.js",
    "test:migrations": "npm run build:report-renderer && node --env-file=.env.local scripts/verify-migrations.js",
    "test:e2e": "playwright test",
    "benchmark:templates": "node --env-file=.env.local scripts/benchmark-templates.js",
    "benchmark:datasheets": "node --env-file=.env.local scripts/benchmark-datasheets.js",
    "benchmark:master-bulk": "node scripts/benchmark-master-bulk.js",
    "benchmark:product-fields": "node --env-file=.env.local scripts/benchmark-product-fields.js",
    "benchmark:method-fields": "node --env-file=.env.local scripts/benchmark-method-fields.js",
    "benchmark:customer-fields": "node --env-file=.env.local scripts/benchmark-customer-fields.js",
    "benchmark:vendor-fields": "node --env-file=.env.local scripts/benchmark-vendor-fields.js",
    "benchmark:product-context": "node --env-file=.env.local scripts/benchmark-product-context.js",
    "benchmark:browser": "playwright test --config=playwright.performance.config.js tests/performance/designer.spec.js",
    "benchmark:datasheet-browser": "playwright test --config=playwright.performance.config.js tests/performance/datasheets.spec.js",
    "benchmark:product-fields-browser": "playwright test --config=playwright.performance.config.js tests/performance/product-fields.spec.js",
    "benchmark:method-fields-browser": "playwright test --config=playwright.performance.config.js tests/performance/method-fields.spec.js",
    "benchmark:product-context-browser": "playwright test --config=playwright.performance.config.js tests/performance/product-context.spec.js",
    "verify": "npm run lint && npm test && npm run test:integration && npm run build && npm run test:e2e",
    "build:report-renderer": "node scripts/build-report-renderer.js",
    "worker:setup": "node scripts/local-report-worker.js",
    "worker:reports": "node --env-file=.env.worker.local scripts/report-worker.js"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "@tabler/icons-react": "3.41.1",
    "@tanstack/react-virtual": "3.14.13",
    "@xmldom/xmldom": "0.9.12",
    "bootstrap": "5.3.8",
    "classnames": "2.5.1",
    "css-tree": "3.2.1",
    "drizzle-orm": "0.45.2",
    "exceljs": "4.4.0",
    "hyperformula": "^3.4.0",
    "moment": "2.30.1",
    "moment-timezone": "0.6.3",
    "next": "16.3.4",
    "pg": "8.23.0",
    "playwright-core": "1.63.0",
    "postcss": "8.5.23",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-select": "5.10.2",
    "react-spreadsheet": "0.10.1",
    "sanitize-html": "2.17.7",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "sass": "1.104.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
