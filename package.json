{
  "name": "sampleify-lims",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.0 <23"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "db:local": "node scripts/local-database.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local scripts/migrate.js",
    "db:seed": "node --env-file=.env.local scripts/seed.js",
    "test": "node --test tests/unit/*.test.js",
    "test:integration": "node --env-file=.env.local --test --test-concurrency=1 tests/integration/*.test.js",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm test && npm run test:integration && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "@tabler/icons-react": "3.41.1",
    "bootstrap": "5.3.8",
    "classnames": "2.5.1",
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "sass": "1.104.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
